<?xml version="1.0"?>
<!--
  URDF гусеничного робота — упрощённый (без визуального тела).

  СИСТЕМА КООРДИНАТ (REP-103): X — вперёд, Y — влево, Z — вверх.

  Убраны chassis_link, left_track_link, right_track_link — они были только
  визуальными (корпус/гусеницы для RViz) и не влияют на навигацию.
  Одометрия приходит из kolesa_control (robot_x/robot_y/robot_yaw),
  а не из этих джойнтов.

  Остались только функциональные фреймы:
    base_link      — корень TF (обязателен)
    imu_link       — MPU6050
    mag_gps_link   — корпус GPS+компас
    gps_link       — точка приёма GPS-антенны (дочерний от mag_gps_link)
    laser_frame    — лидар
-->
<robot name="tracked_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Материал для визуализации датчиков (мелкие коробки в RViz) -->
  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <!-- ============ корень TF ============ -->
  <link name="base_link"/>

  <!-- ============ фреймы датчиков (ПРАВЬТЕ КООРДИНАТЫ ЗДЕСЬ) ============ -->
  <xacro:property name="imu_xyz"     value="0.135 -0.275 0.4" />
  <xacro:property name="mag_gps_xyz" value="0.11 -0.085 0.4" />
  <xacro:property name="laser_xyz"   value="-0.21 0.16 0.55" />

  <!-- MPU6050 (отдельный модуль) -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.02 0.02 0.01"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="${imu_xyz}" rpy="0 0 0"/>
  </joint>

  <!-- Корпус GPS+компас (компас и GPS в одном корпусе) -->
  <link name="mag_gps_link">
    <visual>
      <geometry><box size="0.04 0.03 0.01"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="base_to_mag_gps" type="fixed">
    <parent link="base_link"/>
    <child  link="mag_gps_link"/>
    <origin xyz="${mag_gps_xyz}" rpy="0 0 0"/>
  </joint>

  <!-- Точка приёма GPS-антенны: встроенная -> совпадает с корпусом -->
  <link name="gps_link"/>
  <joint name="mag_gps_to_gps" type="fixed">
    <parent link="mag_gps_link"/>
    <child  link="gps_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Лидар -->
  <link name="laser_frame">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_frame"/>
    <origin xyz="${laser_xyz}" rpy="0 0 0"/>
  </joint>

</robot>
