<?xml version="1.0"?>
<robot name="lidar_robot">

  <!-- Материалы -->
  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.5 0.1 1.0"/>
  </material>

  <!-- ================================================== -->
  <!-- 1. БАЗОВОЕ ЗВЕНО (корпус робота)                   -->
  <!-- ================================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.1 0.8 0.6"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.1 0.8 0.6"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0"
               iyy="0.8" iyz="0.0"
               izz="0.7"/>
    </inertial>
  </link>

  <!-- ================================================== -->
  <!-- 2. ЛИДАР (исправленная ориентация)                 -->
  <!-- ================================================== -->
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001"/>
    </inertial>
  </link>

  <!-- ================================================== -->
  <!-- 3. СОЕДИНЕНИЕ (исправлен поворот)                  -->
  <!--    Поворот на 180° вокруг Z, чтобы развернуть оси  -->
  <!-- ================================================== -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 0.3" rpy="3.14159 3.14159 3.14159"/>
  </joint>

</robot>