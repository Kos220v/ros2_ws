# ============================================================================
# Пример файла маршрута для robot_commander (параметр waypoints_file).
#
# Скопируйте этот файл в waypoints.yaml и заполните реальными координатами
# ВАШЕГО места (значения ниже — координаты Москвы просто для примера формата,
# ехать по ним не нужно).
#
# Как получить координаты точек маршрута:
#   1. Google Maps / Яндекс.Карты: щёлкните правой кнопкой по точке на карте —
#      появятся координаты (широта, долгота), скопируйте их.
#   2. Пройдите/проедьте маршрут с включённым GPS-модулем и запишите его трек
#      (например, `ros2 topic echo /gps/fix > track.txt`), затем выберите
#      опорные точки из трека.
#   3. Для точной работы (± 1-3 м) используйте RTK-GPS или скорректируйте
#      маршрут по данным SLAM-карты (см. раздел про SLAM в документации).
#
# Поля точки:
#   lat    — широта, градусы (обязательно)
#   lon    — долгота, градусы (обязательно)
#   radius — радиус прибытия в этой точке, метры (необязательно;
#            по умолчанию берётся параметр arrival_distance)
#
# Точность бытового GPS-модуля (NEO-6M/NEO-8M и т.п.) без RTK — обычно
# 2.5-5 метров. Не ставьте radius меньше ~2 м, иначе робот может никогда
# не "долететь" до точки и будет крутиться на месте.
# ============================================================================

waypoints:
  - lat: 55.751244
    lon: 37.618423
    radius: 2.0
  - lat: 55.751500
    lon: 37.619200
    radius: 2.0
  - lat: 55.751800
    lon: 37.618000
    radius: 2.5
