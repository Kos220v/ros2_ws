# ПРАВИЛА udev для USB-устройств робота (лидар + GPS)
#
# УСТАНОВКА:
#   sudo cp 99-robot-usb.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#   (переподключите USB-устройства или перезагрузите робота)
#
# СХЕМА ПОРТОВ (по ТЗ):
#   ЛИДАР  (YDLidar Tmini Plus, Silicon Labs CP210x, VID:PID 10c4:ea60)
#           -> /dev/lidar   (раньше был ttyUSB1 из-за порядка подключения)
#   GPS    (Prolific PL2303, VID:PID 067b:2303)
#           -> /dev/gps     (раньше был ttyUSB0)
#
# ПОЧЕМУ: номера ttyUSB* зависят от порядка подключения USB и могут
# меняться между загрузками. Постоянные имена по VID/PID — надёжны.
# После установки правил в launch используйте /dev/lidar и /dev/gps
# (см. start.launch.py).

# Лидар: Silicon Labs CP210x USB-UART
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0666", SYMLINK+="lidar"

# GPS: Prolific PL2303 USB-UART
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="2303", MODE="0666", SYMLINK+="gps"

# Резерв: любые USB-UART (ttyUSB/ttyACM) — дать доступ всем
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", MODE="0666"
SUBSYSTEM=="tty", KERNEL=="ttyACM*", MODE="0666"
