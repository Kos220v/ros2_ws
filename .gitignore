# Артефакты сборки ROS 2 — не должны попадать в репозиторий
build/
install/
log/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Файлы-бэкапы редакторов
*.save
*~
*.swp

# Личные маршруты: координаты привязаны к конкретному месту,
# в общий репозиторий им не место. Образец лежит в
# robot_navigation/config/gps_waypoints.yaml
/routes/
